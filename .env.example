# ── Entorno VPS ──────────────────────────────────────────────
# Copia este archivo como .env y completa los valores
# El archivo .env NUNCA se sube al repositorio

# ── Google OAuth2 ─────────────────────────────────────────────
# Obtener desde Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generado por: node scripts/get-refresh-token.js (correr UNA VEZ localmente)
GOOGLE_REFRESH_TOKEN=

# ── API Hostinger ─────────────────────────────────────────────
HOSTINGER_API_URL=https://api.batidospitaya.com
HOSTINGER_API_TOKEN=c5b155ba8f6877a2eefca0183ab18e37fe9a6accde340cf5c88af724822cbf50

# ── Cron ─────────────────────────────────────────────────────
# Formato cron estándar. Default: 2am todos los días
CRON_SCHEDULE=0 2 * * *

# ── Concurrencia ──────────────────────────────────────────────
# Máximo de sucursales procesadas en paralelo
CONCURRENCY=5

# ── Servidor HTTP interno ─────────────────────────────────────
# Puerto para trigger manual y status desde el ERP
PORT=3009
